{
  "name": "later",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Personal read-it-later app",
  "scripts": {
    "dev": "npx -y netlify-cli dev --offline",
    "deploy": "npx -y netlify-cli deploy --prod",
    "icons": "python3 scripts/make_icons.py",
    "shortcut": "python3 scripts/make_shortcut.py",
    "zip": "rm -f public/later-extension.zip && cd extension && zip -qr ../public/later-extension.zip . -x '.*'"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@netlify/blobs": "^10.0.0",
    "linkedom": "^0.18.0"
  },
  "license": "MIT"
}
