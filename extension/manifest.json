{
  "manifest_version": 3,
  "name": "Later",
  "version": "1.1.0",
  "description": "Save the page you're on to your own Later reading list.",
  "permissions": ["activeTab", "scripting", "cookies", "contextMenus", "storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "action": {
    "default_title": "Save to Later",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save this page to Later"
    }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
